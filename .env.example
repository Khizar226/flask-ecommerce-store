# Copy to .env and fill in. Never commit the real .env file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Optional: from `stripe listen --forward-to localhost:5000/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

BASE_URL=http://127.0.0.1:5000
DATABASE_URL=sqlite:///shop.db
STORE_CURRENCY=usd

# Local development only. Set SESSION_COOKIE_SECURE=1 when serving over HTTPS.
FLASK_DEBUG=1
SESSION_COOKIE_SECURE=0
